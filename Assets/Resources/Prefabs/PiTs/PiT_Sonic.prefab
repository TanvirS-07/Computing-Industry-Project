--- !u!1001 &6668042224218049797
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 3791407810210190234}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: "The Super Nintendo Entertainment System (SNES) was released in 1990
        as Nintendo's direct console competitor to the SEGA Genesis. It greatly overshadowed
        the Genesis in processing a varied color palette, being able to display 256
        colors from a 32768 color palette at once. The console's edge was demonstrated
        in successful games, such as Earthbound (1993), Donkey Kong Country (1994),
        Final Fantasy VI (1993) and Super Mario World (1991). \n\nThe release of
        the SNES flourished the advent of the first console war, leading to a heated
        marketing rivalry between SEGA and Nintendo up until 1995. In 1995, Sony
        would enter the market with their own console the Playstation, a 5th generation
        console that was widely superior to the Genesis and SNES' processing capabilities.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_fontSize
