--- !u!1001 &3807688727659069833
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 5642980575723579230}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'Video games have historically been marketed to a younger audience or
        were suited to competitive/dedicated players.


        Mobile games were
        modeled to encourage ritualistic play patterns through recurring daily activities,
        shorter game sessions and bite-sized gameplay, most income coming from in-app
        purchases.


        Games such as Fruit Ninja, Clash of Clans, Temple Run
        and Candy Crush Saga solidified the formula of mobile games through integrating
        social media into play, making gameplay accessible to a wide casual audience
        and integrating freemium models.

'
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_fontSize
