--- !u!1001 &5651894695343880806
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 5518762943631912918}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'DOOM was previously banned or rated as 17+ Mature im many countries.
        The extremely graphic content and satanic imagery presented in its gameplay
        created controversy and debate around entertainment boards.


        As
        a result, the moral panic and debate over the concept of "video games inciting
        violent action" flared up, joining games such as Death Race 2000, Night Trap,
        Mortal Kombat, and so on. Moral panic around video games came under the pretense
        that playing them would "desensitize the player to the actions they were
        committing in-game".'
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_fontSize
