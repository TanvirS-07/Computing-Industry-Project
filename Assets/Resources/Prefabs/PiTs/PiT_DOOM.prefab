--- !u!1001 &859946763821323095
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 7481753468663446487}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: '2.5D graphics combine both 2D assets and a 3D environment in play.
        The game''s sprites, UI and models are all made in 2D while the 3D environment
        is simulated through multiple projection techniques.


        However, there
        were limitations to the systems: Floor design had to stick to mostly flat
        surfaces with little room for verticality, looking up or down either had
        significant restrictions or was not allowed at all. models and maps had to
        remain simple.'
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_fontSize
