--- !u!1001 &6110356109417787163
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 3383614405985767020}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: "This form of graphics was present from the 1970s in arcade games, but
        started to see use in prominent games such as Super Mario Kart, Super Mario
        64, Doom, Wolfenstein 3D and Duke Nukem 3D. \n\nDoom and Wolfenstein 3D were
        not the first games to use these graphics, but their breakout success pioneered
        the coining of the term \"2.5D games\". They were major stepping-stones in
        the transition from 2D to 3D."
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
