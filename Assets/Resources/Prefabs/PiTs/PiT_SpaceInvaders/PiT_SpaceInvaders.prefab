    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'Many notable arcade games that had been produced during this period
        contributed a significant influence to the history of video games and graphics
        in general, such as:

        Pong (1972)

        Space Invaders (1979)

        Pac
        Man (1980)

        Donkey Kong (1981)'
      objectReference: {fileID: 0}
