--- !u!1001 &4431506584683311831
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1722373992481579053}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: "In addition, the \"Battle Pass model\", the use of \"fear of missing
        out\" (FOMO) and cosmetic-based monetization system of Fortnite has been
        replicated by many games due to its financial success. \nOther popular titles,
        such as Genshin Impact, Player Unknown's Battlegrounds, Helldivers and Brawl
        Stars have all mimicked Fortnite's systems. These systems encourage players
        to play by utilizing tiered rewards and limited-time cosmetics to entice
        them into investing time into the game.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_fontSize
      value: 0.06
      objectReference: {fileID: 0}
