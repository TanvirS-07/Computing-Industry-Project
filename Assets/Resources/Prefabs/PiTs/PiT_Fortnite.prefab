--- !u!1001 &4414499933672643017
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 8402161872053306677}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'Emotes in fortnite have played a significant role in the game''s cosmetic-based
        marketing.

        Players perform emotes in Fortnite''s environment as
        a form of expression to any action/event occurring in-game or to socially
        interact with other players. Additionally, emotes following popular social
        media trends (dances or songs) were implemented to entice players to purchase
        emotes to follow trends, or introduce new players to the game.'
      objectReference: {fileID: 0}
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_fontSize
