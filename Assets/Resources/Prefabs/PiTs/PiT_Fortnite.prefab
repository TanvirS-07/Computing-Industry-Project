--- !u!1001 &9107529241166252463
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 6244467373719775263}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'Fortnite''s cultural impact extends beyond the game itself, creating
        new mainstream trends and being pivotal in bringing media''s into the mainstream.


        The
        game''s emotes and itself has created popular meme formats and integrated
        itself into aspects of human culture. In-game events, such as the Thanos
        infinity gauntlet item and Travis Scott concert have elevated the standards
        for game events. Frequent collaborations with celebrities, popular media,
        artists and current trends through in-game additions have further promoted
        franchises and brought in new audiences to the game itself.

'
      objectReference: {fileID: 0}
