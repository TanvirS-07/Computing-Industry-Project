    m_TransformParent: {fileID: 1258383910190195397}
    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'The Utah Teapot is a symbolic representation of graphics modelling
        and lighting.


        It was commonly used as a placeholder, offering

        a
        simple, yet complex design for early graphics development, from rounded surfaces
        to casting shadows upon itself.


        The teapot model was created by
        Martin Newell in 1975. You can see it in animations to this day!'
      objectReference: {fileID: 0}
