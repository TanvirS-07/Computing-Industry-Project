    m_Modifications:
    - target: {fileID: 2116517601969916342, guid: 183e809bca3827e41a67b7345a91f0c2, type: 3}
      propertyPath: m_text
      value: 'In Super Mario 64, many objects such as trees and coins use a flat
        picture that always faces the camera. This is called "billboarding".


        Some
        objects use a billboard <i>and</i> a 3D model!, like this Bob-Omb!

        The
        billboard''s rotation has been disabled so you can see how it works.'
      objectReference: {fileID: 0}
